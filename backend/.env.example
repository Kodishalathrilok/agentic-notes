# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# NVIDIA NIM (build.nvidia.com). Setting NVIDIA_API_KEY makes NVIDIA the
# app's primary provider: its models are listed first, so the default model
# and the model picker both start there. Any other provider key you leave set
# becomes an automatic fallback instead of a competitor.
#
# NVIDIA_MODEL must be the EXACT catalog id from build.nvidia.com — copy it
# from the model's page. Catalog ids are namespaced and versioned, e.g.
#   nvidia/llama-3.1-nemotron-ultra-253b-v1
#   nvidia/llama-3.3-nemotron-super-49b-v1
# The default below is only a placeholder; verify it against the catalog.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Optional: extra ids (comma-separated) to offer in the model picker.
# NVIDIA_MODEL stays first and remains the default; these are added after
# it, giving you a speed/quality ladder and somewhere to go when the big
# model's daily quota is gone.
#
# CHECK THESE BEFORE TRUSTING THEM. NVIDIA end-of-lifes catalog ids without
# warning and a dead one answers 410 Gone mid-request:
# nemotron-3-nano-30b-a3b was measured at 1.7s on 2026-08-25 and was gone by
# 2026-09-01. List what is actually live with:
#   curl -H "Authorization: Bearer $NVIDIA_API_KEY" #        https://integrate.api.nvidia.com/v1/models
# Live as of 2026-09-01: super-120b 4.6s, nano-omni-30b-reasoning 6.0s.
NVIDIA_MODELS=
# Optional: a cheaper id for the mechanical agents (gatekeeper, title, quiz,
# flashcards). Unset means they run on NVIDIA_MODEL, which wastes the big
# model's daily quota on packaging steps — point this at a small catalog id
# (e.g. nvidia/nemotron-3-nano-30b-a3b) to keep the writer's budget for writing.
HELPER_NVIDIA_MODEL=
# Optional: override the API base (defaults to NVIDIA's hosted endpoint).
NVIDIA_BASE_URL=

# Reasoning models (Nemotron Ultra etc.) spend completion tokens thinking
# before they emit any answer, and max_tokens caps both together. This is
# added to every NVIDIA request so short calls (the 30-token title, the
# 200-token gatekeeper) don't burn their whole budget on reasoning and return
# an empty string. It's a cap, not a target — raising it costs nothing unless
# the model uses it. Lower only if you hit hard per-request limits.
NVIDIA_REASONING_HEADROOM=1024
# Whether the model reasons before it answers. Default "off": measured on
# Nemotron 3, thinking made a window of notes take 91 s instead of 17-20 s, and
# the critique and grounding check came back empty because the whole budget
# went on reasoning. "on" restores the old behaviour.
NVIDIA_THINKING=off
# How many times an empty 200 from NVIDIA is asked for again before failing
# over (it happens under load and comes back within about a second).
NVIDIA_EMPTY_RETRIES=2
# After Gemini has used up its retries on a 429 / 503, skip it for this long.
GEMINI_COOLDOWN_S=60

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---------------------------------------------------------------------------
# Gemini (free key at aistudio.google.com)
# ---------------------------------------------------------------------------
# Does three jobs: the automatic fallback when NVIDIA errors or is rate
# limited, image OCR and audio transcription (/api/extract-image and
# /api/transcribe refuse to run without it), and neural/semantic RAG
# embeddings (retrieval falls back to built-in TF-IDF when unset).
GEMINI_API_KEY=
# Pinned to a fast, generally-available release. Google DOES retire ids
# (gemini-2.0-flash and gemini-2.5-flash are both gone, and a retired id 404s
# mid-request) — so the router automatically retries on the "-latest" alias if
# one of these dies. Don't set these TO the aliases: the alias tracks the
# newest release, which is the most capacity-constrained. Measured 2026-08-25,
# 3 calls each: gemini-flash-latest 1/3 success at 90-170s, gemini-3.6-flash
# 3/3 at ~5s. Update the pins when the fallback log line starts appearing.
GEMINI_MODEL=gemini-3.6-flash
HELPER_GEMINI_MODEL=gemini-3.5-flash-lite
# Current Flash models spend tokens thinking before they answer, and those
# count against maxOutputTokens — without headroom the short calls (30-token
# title, 200-token gatekeeper) return an empty string. A cap, not a target.
GEMINI_REASONING_HEADROOM=1024

# How many times a 429 (rate limited) or 503 (overloaded) is retried, with
# backoff, before the request falls through to the next provider.
RATE_LIMIT_RETRIES=3

# NVIDIA only: a 503 ("busy") is retried this many times, after Retry-After or
# NVIDIA_503_RETRY_DELAY seconds, then the call fails over to Gemini and that
# NVIDIA model is skipped for NVIDIA_503_COOLDOWN_S seconds (never when NVIDIA
# is the only provider configured). 429s keep RATE_LIMIT_RETRIES above.
NVIDIA_503_RETRIES=1
NVIDIA_503_RETRY_DELAY=1.0
NVIDIA_503_COOLDOWN_S=60

# Independent model calls run concurrently, at most this many per generation
# (server-wide: x MAX_CONCURRENT_GENERATIONS). 1 = the old sequential loop.
# Results are merged in the original order, so output does not change.
GROUNDING_CONCURRENCY=4
DIGEST_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production)
# ---------------------------------------------------------------------------
# These are the SERVER's copy of the Supabase settings. They are separate from
# the VITE_SUPABASE_* variables the frontend is built with — setting only those
# leaves the API open to anyone who knows its URL, because the server would
# never verify the tokens the frontend sends.
#
# Provide either the URL + anon key (verifies each token by asking Supabase)...
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ...or the project's JWT secret (verifies locally, no network call — faster).
SUPABASE_JWT_SECRET=

# Optional: comma-separated allowlist. Empty = any signed-in Supabase user.
# Leave EMPTY for a public/portfolio deployment — setting it means anyone not
# on the list gets a 403 the moment they try to generate anything, which reads
# as "the app is broken" to someone evaluating it. Use the daily caps below to
# protect the token quota instead.
ALLOWED_EMAILS=

# Per-account DAILY caps on the endpoints that spend model tokens. The short
# sliding windows in auth.py stop bursts but reset forever; these are what stop
# one visitor draining a free tier's daily token quota.
DAILY_GENERATIONS=10
DAILY_EXTRACTS=40
DAILY_REGENS=40
DAILY_CHATS=60

# Override the automatic choice. Leave unset unless you know why you need it.
REQUIRE_AUTH=

# Explicitly run with NO authentication. A production start (DEV=0) with none
# of the above set refuses to boot unless this is true.
ALLOW_ANONYMOUS=
