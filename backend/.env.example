GROQ_API_KEY=your_groq_api_key_here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional: enables neural/semantic RAG embeddings (free key at aistudio.google.com).
# If unset, retrieval falls back to a built-in TF-IDF backend.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Authentication (REQUIRED in production)
# ---------------------------------------------------------------------------
# These are the SERVER's copy of the Supabase settings. They are separate from
# the VITE_SUPABASE_* variables the frontend is built with — setting only those
# leaves the API open to anyone who knows its URL, because the server would
# never verify the tokens the frontend sends.
#
# Provide either the URL + anon key (verifies each token by asking Supabase)...
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ...or the project's JWT secret (verifies locally, no network call — faster).
SUPABASE_JWT_SECRET=

# Optional: comma-separated allowlist. Empty = any signed-in Supabase user.
# Leave EMPTY for a public/portfolio deployment — setting it means anyone not
# on the list gets a 403 the moment they try to generate anything, which reads
# as "the app is broken" to someone evaluating it. Use the daily caps below to
# protect the token quota instead.
ALLOWED_EMAILS=

# Per-account DAILY caps on the endpoints that spend model tokens. The short
# sliding windows in auth.py stop bursts but reset forever; these are what stop
# one visitor draining a free tier's daily token quota.
DAILY_GENERATIONS=10
DAILY_EXTRACTS=40
DAILY_REGENS=40
DAILY_CHATS=60

# Override the automatic choice. Leave unset unless you know why you need it.
REQUIRE_AUTH=

# Explicitly run with NO authentication. A production start (DEV=0) with none
# of the above set refuses to boot unless this is true.
ALLOW_ANONYMOUS=
